# Copy to .env.local. Never commit real values.
# Do not use NEXT_PUBLIC_ for any of these.

# Local file SQLite via libSQL. On Vercel use a Turso URL instead.
DATABASE_URL=file:.data/hub.db
# The native Vercel/Turso integration provides this alias automatically.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BLOB_READ_WRITE_TOKEN=

APP_ORIGIN=http://localhost:3000
TOKEN_VAULT_KEY=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202609
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SCHEDULER_SECRET=
CRON_SECRET=
EMAIL_DELIVERY_ENABLED=false
EMAIL_SYNC_ENABLED=false

# Meta: Facebook Login for Business, User access-token configuration
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v27.0
