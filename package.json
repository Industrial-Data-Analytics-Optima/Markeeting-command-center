{
  "name": "marketing-command-center",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "secrets": "node scripts/generate-secrets.mjs",
    "turso:provision": "node scripts/provision-turso.mjs",
    "owner:invite": "node scripts/bootstrap-owner.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm audit --audit-level=moderate",
    "review:smoke": "node --experimental-strip-types scripts/review-smoke.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@vercel/blob": "^2.9.0",
    "next": "16.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "typescript": "5.9.3",
    "prettier": "3.10.1"
  },
  "type": "module",
  "overrides": {
    "zod": "4.6.6"
  }
}
